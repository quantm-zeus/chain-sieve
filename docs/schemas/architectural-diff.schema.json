{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string"
    },
    "importsAdded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "importsRemoved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "publicInterfacesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "migrationsAdded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilityChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "importsAdded",
    "importsRemoved",
    "publicInterfacesChanged",
    "migrationsAdded",
    "capabilityChanges"
