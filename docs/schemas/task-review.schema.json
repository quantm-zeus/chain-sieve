{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "taskId": {
      "type": "string"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedBaseCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "reviewedCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "reviewedTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "changedFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "A",
              "C",
              "M",
              "R",
              "T",
              "U",
              "X",
              "B",
              "D"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "dependencyInterfaceHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "acceptanceTestArtifacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "leaseId": {
      "type": "string",
      "minLength": 1
    },
    "leaseFencingVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "rebase": {
      "type": "object",
      "properties": {
        "previousHeadCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "conflictsDetected": {
          "type": "boolean"
        },
        "semanticChangesDetected": {
          "type": "boolean"
        }
      },
      "required": [
        "conflictsDetected",
        "semanticChangesDetected"
      ],
      "additionalProperties": false
    },
    "passes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "PASS"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "CHANGES_REQUIRED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "severity",
          "text",
          "resolved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "reviewer",
    "reviewedBaseCommit",
    "reviewedCommit",
    "reviewedTree",
    "changedFiles",
    "dependencyInterfaceHashes",
    "acceptanceTestArtifacts",
    "leaseId",
    "leaseFencingVersion",
    "reviewedAt",
    "rebase",
    "passes",
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
