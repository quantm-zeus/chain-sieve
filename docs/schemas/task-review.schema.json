{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "taskId": {
      "type": "string"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewedCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "reviewedTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "passes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "PASS"
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "CHANGES_REQUIRED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "severity",
          "text",
          "resolved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "reviewer",
    "reviewedCommit",
    "reviewedTree",
    "passes",
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
