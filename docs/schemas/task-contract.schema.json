{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^T-G[0-7]-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceHashes": {
      "type": "object",
      "properties": {
        "prd": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirements": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "prd",
        "requirements",
        "audit"
      ],
      "additionalProperties": false
    },
    "dependencyGroup": {
      "type": "string",
      "pattern": "^G[0-7]$"
    },
    "cluster": {
      "type": "string",
      "pattern": "^C-G[0-7]-[A-Z0-9-]+$"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "autonomyLevel": {
      "type": "string",
      "enum": [
        "AUTONOMOUS",
        "REVIEW_REQUIRED",
        "OWNER_APPROVAL_REQUIRED"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownerPackages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writeSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedPaths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusiveLocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interfaceHashes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonGoals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "degradedBehavior": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "requiredTests": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationCommands": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "expected"
        ],
        "additionalProperties": false
      }
    },
    "complexityBudget": {
      "type": "object",
      "properties": {
        "maxFiles": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxChangedLines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCyclomaticComplexity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxFiles",
        "maxChangedLines",
        "maxCyclomaticComplexity"
      ],
      "additionalProperties": false
    },
    "changeBudget": {
      "type": "object",
      "properties": {
        "maxMigrations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxPublicInterfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiresSplitAboveBudget": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "maxMigrations",
        "maxPublicInterfaces",
        "requiresSplitAboveBudget"
      ],
      "additionalProperties": false
    },
    "stopConditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completionDefinition": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceReferences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "line",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sourceHashes",
    "dependencyGroup",
    "cluster",
    "riskLevel",
    "autonomyLevel",
    "dependencies",
    "requirements",
    "acceptanceCriteria",
    "invariants",
    "adrs",
    "ownerPackages",
    "readSet",
    "writeSet",
    "allowedPaths",
    "forbiddenPaths",
    "exclusiveLocks",
    "interfaceHashes",
    "deliverables",
    "constraints",
    "nonGoals",
    "degradedBehavior",
    "rollback",
    "requiredTests",
    "verificationCommands",
    "complexityBudget",
    "changeBudget",
    "stopConditions",
    "completionDefinition",
    "sourceReferences"
  ],
  "additionalProperties": false
}
