{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taskId": {
      "type": "string"
    },
    "sourceHashes": {
      "type": "object",
      "properties": {
        "prd": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirements": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "prd",
        "requirements",
        "audit"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "conformanceManifestPath": {
      "type": "string",
      "minLength": 1
    },
    "conformanceManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedAt": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "sourceHashes",
    "files",
    "generatedAt"
  ],
  "additionalProperties": false
}
