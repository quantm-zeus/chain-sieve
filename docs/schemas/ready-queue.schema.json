{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "generatedFrom": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ready": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": [
              "DEPENDENCY_BLOCKED",
              "SPECIFICATION_GAP"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "taskId",
          "reason",
          "dependencies"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "implementationReady": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "specificationGap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "implementationReady",
        "specificationGap"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedFrom",
    "ready",
    "blocked",
    "counts"
  ],
  "additionalProperties": false
}
