{
  "name": "crypto-intelligence-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": "22.23.1", "pnpm": "10.13.1" },
  "scripts": {
    "build": "pnpm prd:compile && tsc -p tsconfig.json --noEmit && pnpm --filter @ciag/dashboard build",
    "dev": "concurrently -n api,dashboard 'pnpm --filter @ciag/api dev' 'pnpm --filter @ciag/dashboard dev'",
    "lint": "eslint .",
    "format": "tsx tools/task-verifier/format.ts write",
    "format:check": "tsx tools/task-verifier/format.ts check",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @ciag/dashboard check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:system": "vitest run tests/system",
    "test:service": "vitest run --config vitest.service.config.ts",
    "test:harness": "vitest run tests/harness",
    "test:mutation": "vitest run tests/spec-mutation",
    "test:e2e": "playwright test",
    "spec:verify": "tsx tools/task-verifier/cli.ts spec:verify",
    "prd:compile": "tsx tools/prd-compiler/cli.ts compile",
    "prd:drift-check": "tsx tools/prd-compiler/cli.ts drift-check",
    "task:list": "tsx tools/task-runner/cli.ts list",
    "task:ready": "tsx tools/task-runner/cli.ts ready",
    "task:validate": "tsx tools/task-runner/cli.ts validate",
    "task:mark-ready": "tsx tools/task-runner/cli.ts mark-ready",
    "task:acquire": "tsx tools/task-runner/cli.ts acquire",
    "task:begin": "tsx tools/task-runner/cli.ts begin",
    "task:self-review": "tsx tools/task-runner/cli.ts self-review",
    "task:self-review-correct": "tsx tools/task-runner/cli.ts self-review-correct",
    "task:self-review-refresh": "tsx tools/task-runner/cli.ts self-review-refresh",
    "task:verify": "tsx tools/task-verifier/cli.ts task",
    "task:complete": "tsx tools/task-runner/cli.ts complete",
    "task:release": "tsx tools/task-runner/cli.ts release",
    "cluster:list": "tsx tools/cluster-verifier/cli.ts list",
    "cluster:ready": "tsx tools/cluster-verifier/cli.ts ready",
    "cluster:verify": "tsx tools/cluster-verifier/cli.ts verify",
    "cluster:report": "tsx tools/cluster-verifier/cli.ts report",
    "requirements:coverage": "tsx tools/task-verifier/cli.ts coverage",
    "architecture:verify": "tsx tools/architecture-verifier/cli.ts architecture",
    "tests:skeleton-integrity": "vitest run tests/system/walking-skeleton.spec.ts",
    "placeholders:scan": "tsx tools/architecture-verifier/cli.ts placeholders",
    "prohibited-capabilities:scan": "tsx tools/architecture-verifier/cli.ts prohibited",
    "migration:verify": "vitest run tests/integration/migrations.spec.ts",
    "db:migrate": "tsx tools/migration/cli.ts",
    "harness:verify": "tsx tools/task-verifier/cli.ts harness",
    "harness:lifecycle": "tsx tools/merge-queue/lifecycle-cli.ts",
    "worktree:create": "tsx tools/worktree-manager/cli.ts create",
    "worktree:status": "tsx tools/worktree-manager/cli.ts status",
    "worktree:cleanup": "tsx tools/worktree-manager/cli.ts cleanup",
    "merge-queue:add": "tsx tools/merge-queue/cli.ts add",
    "merge-queue:process": "tsx tools/merge-queue/cli.ts process",
    "agent": "tsx tools/agent/orchestrator.ts",
    "agent:status": "tsx tools/agent/status.ts",
    "agent:renew": "tsx tools/agent/lifecycle.ts renew",
    "agent:recover": "tsx tools/agent/lifecycle.ts recover",
    "autopilot": "tsx tools/autopilot/cli.ts",
    "agent:migration-check": "tsx tools/agent/lifecycle.ts migration-check",
    "agent:migrate": "tsx tools/agent/lifecycle.ts migrate",
    "antigravity": "pnpm agent -- --provider antigravity",
    "zcode": "pnpm agent -- --provider zcode",
    "zcode:status": "pnpm agent:status",
    "zcode:g0": "pnpm agent -- --provider zcode"
  },
  "dependencies": {
    "@ciag/alerts": "workspace:*",
    "@ciag/capability-registry": "workspace:*",
    "@ciag/config": "workspace:*",
    "@ciag/domain": "workspace:*",
    "@ciag/evaluation": "workspace:*",
    "@ciag/evidence": "workspace:*",
    "@ciag/object-store": "workspace:*",
    "@ciag/observability": "workspace:*",
    "@ciag/persistence": "workspace:*",
    "@ciag/provider-contracts": "workspace:*",
    "@ciag/runtime-cache": "workspace:*",
    "@ciag/security": "workspace:*",
    "@ciag/shared-schemas": "workspace:*",
    "@ciag/test-fixtures": "workspace:*",
    "@ciag/tool-core": "workspace:*",
    "@ciag/workflow-runtime": "workspace:*",
    "@aws-sdk/client-s3": "^3.850.0",
    "@hono/node-server": "^1.18.2",
    "@hono/zod-openapi": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.17.2",
    "drizzle-orm": "0.45.2",
    "hono": "^4.8.9",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@sveltejs/adapter-node": "^5.3.1",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.4",
    "concurrently": "^9.2.0",
    "esbuild": "0.25.8",
    "eslint": "^9.31.0",
    "fast-check": "^4.2.0",
    "globals": "^16.3.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.36.16",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
