#!/usr/bin/env bash
set -euo pipefail

real_binary="${CHAINSIEVE_MUSE_REAL:-/usr/local/lib/chainsieve/providers/muse}"

if [[ ! -x "$real_binary" ]]; then
  echo "configured Muse binary is not executable: $real_binary" >&2
  exit 127
fi

# The installed target is the exact release binary, not Muse's auto-updating
# launcher. Retain the environment guard as defense in depth.
export MUSE_NO_AUTO_UPDATE=1
exec "$real_binary" "$@"
