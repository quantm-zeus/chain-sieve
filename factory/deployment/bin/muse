#!/usr/bin/env bash
set -euo pipefail

real_binary="${CHAINSIEVE_MUSE_BIN:-${CHAINSIEVE_MUSE_REAL:-}}"
model="${CHAINSIEVE_MUSE_MODEL:-}"

if [[ -z "$real_binary" || ! -x "$real_binary" ]]; then
  echo "configured Muse binary is not executable: $real_binary" >&2
  exit 127
fi
[[ ! "$real_binary" -ef "$0" ]] || { echo "refusing recursive Muse wrapper configuration" >&2; exit 78; }

# The installed target is the exact release binary, not Muse's auto-updating
# launcher. Retain the environment guard as defense in depth.
export MUSE_NO_AUTO_UPDATE=1
is_reviewer=false
has_model=false
for argument in "$@"; do
  [[ "$argument" == --disable-write ]] && is_reviewer=true
  [[ "$argument" == --model || "$argument" == --model=* ]] && has_model=true
done

arguments=("$@")
if [[ "$is_reviewer" == true ]]; then
  contract_file="${CHAINSIEVE_REVIEWER_CONTRACT_FILE:-/opt/chainsieve/factory-bin/reviewer-contract.md}"
  [[ -r "$contract_file" ]] || { echo "ChainSieve standing reviewer contract is unavailable: $contract_file" >&2; exit 78; }
  contract="$(<"$contract_file")"
  existing="${TBH_EVAL_APPEND_DEVELOPER_PROMPT:-}"
  if [[ -n "$existing" ]]; then
    export TBH_EVAL_APPEND_DEVELOPER_PROMPT="$existing"$'\n\n'"$contract"
  else
    export TBH_EVAL_APPEND_DEVELOPER_PROMPT="$contract"
  fi
  has_disable_sandbox=false
  for argument in "${arguments[@]}"; do
    [[ "$argument" == --disable-sandbox ]] && has_disable_sandbox=true
  done
  if [[ "$has_disable_sandbox" == false ]]; then
    if [[ ${#arguments[@]} -gt 0 && "${arguments[0]}" != -* ]]; then
      arguments=("${arguments[0]}" "--disable-sandbox" "${arguments[@]:1}")
    else
      arguments=("--disable-sandbox" "${arguments[@]}")
    fi
  fi
fi

if [[ -n "$model" && "$has_model" == false ]]; then
  exec "$real_binary" --model "$model" "${arguments[@]}"
fi
exec "$real_binary" "${arguments[@]}"
