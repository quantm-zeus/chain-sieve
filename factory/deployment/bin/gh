#!/usr/bin/env bash
set -euo pipefail

real_gh="${CHAINSIEVE_REAL_GH:-/usr/bin/gh}"
token_helper="${CHAINSIEVE_GITHUB_TOKEN_HELPER:-/opt/chainsieve/factory-bin/github-app-token}"

if [[ "${1:-}" == auth && "${2:-}" == token ]]; then
  exec "$token_helper"
fi

if [[ -n "${GH_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]]; then
  exec "$real_gh" "$@"
fi

token="$($token_helper)"
exec env GH_TOKEN="$token" "$real_gh" "$@"
