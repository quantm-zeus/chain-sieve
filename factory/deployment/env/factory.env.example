# chmod 0600, owner root:chainsieve-controller
# Integration GitHub App token: create queue issues, approve exact gated heads, and merge.
# This actor must differ from the worker actor.
GH_TOKEN=
# Programmatic Codex authentication per official OpenAI guidance.
OPENAI_API_KEY=
# Muse convergence runs read-only under the controller identity. This provider
# credential is allowlisted only for that subprocess; GH_TOKEN is not inherited.
META_API_KEY=
CHAINSIEVE_MUSE_REAL=/usr/local/lib/chainsieve/providers/muse
MUSE_NO_AUTO_UPDATE=1
# Optional notifier command configuration belongs in factory/config.json; its secrets
# may be referenced here only if the command itself reads them from a protected file.
