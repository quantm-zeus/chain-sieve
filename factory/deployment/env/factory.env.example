# chmod 0600, owner root:chainsieve-controller
# Integration GitHub App: create queue issues, approve exact gated heads, and merge.
# Installation tokens are minted in memory and rotated without daemon restart.
CHAINSIEVE_GITHUB_APP_ID=
CHAINSIEVE_GITHUB_INSTALLATION_ID=
CHAINSIEVE_GITHUB_PRIVATE_KEY_PATH=/etc/chainsieve/integration-app.pem
CHAINSIEVE_INTEGRATION_GITHUB_ACTOR=chainsieve-factory[bot]
CHAINSIEVE_WORKER_GITHUB_ACTOR=chainsieve-worker[bot]
# This actor must differ from CHAINSIEVE_WORKER_GITHUB_ACTOR.
# Programmatic Codex authentication per official OpenAI guidance.
OPENAI_API_KEY=
# Muse convergence runs read-only under the controller identity. This provider
# credential is allowlisted only for that subprocess; GitHub App material is not inherited.
META_API_KEY=
CHAINSIEVE_MUSE_REAL=/usr/local/lib/chainsieve/providers/muse
MUSE_NO_AUTO_UPDATE=1
# Optional notifier command configuration belongs in factory/config.json; its secrets
# may be referenced here only if the command itself reads them from a protected file.
