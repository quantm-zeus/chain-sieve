# chmod 0600, owner root:chainsieve-worker
# Worker GitHub App: independently scoped to fetch, push factory/* branches,
# create/update PRs, and read checks. Installation tokens are minted on demand.
CHAINSIEVE_GITHUB_APP_ID=
CHAINSIEVE_GITHUB_INSTALLATION_ID=
CHAINSIEVE_GITHUB_PRIVATE_KEY_PATH=/etc/chainsieve/worker-app.pem
CHAINSIEVE_WORKER_GITHUB_ACTOR=chainsieve-worker[bot]
CHAINSIEVE_GITHUB_TOKEN_HELPER=/opt/chainsieve/factory-bin/github-app-token
CHAINSIEVE_REAL_GH=/usr/bin/gh
GIT_ASKPASS=/opt/chainsieve/factory-bin/github-app-askpass
GIT_TERMINAL_PROMPT=0
META_API_KEY=
CHAINSIEVE_MUSE_REAL=/usr/local/lib/chainsieve/providers/muse
CHAINSIEVE_AGY_REAL=/usr/local/lib/chainsieve/providers/agy
CHAINSIEVE_AGY_MODEL=gemini-3.6-flash-high
MUSE_NO_AUTO_UPDATE=1
# Never put a generated token or the integration App credential here.
