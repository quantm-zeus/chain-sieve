# chmod 0600, owner root:chainsieve-worker
# Worker GitHub App token: fetch, push factory/* branches, create/update PRs and read checks.
# It must use the configured worker actor and must not be able to approve its own PR.
# AO's native GitHub integration and gh both honor GITHUB_TOKEN.
GITHUB_TOKEN=
META_API_KEY=
CHAINSIEVE_MUSE_REAL=/usr/local/lib/chainsieve/providers/muse
CHAINSIEVE_AGY_REAL=/usr/local/lib/chainsieve/providers/agy
CHAINSIEVE_AGY_MODEL=gemini-3.6-flash-high
MUSE_NO_AUTO_UPDATE=1
# Provider-specific non-secret paths may be added. Never put the integration token here.
