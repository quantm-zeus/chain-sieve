{
  "ownerPackages": [
    "packages/domain"
  ],
  "allowedPaths": [
    "packages/domain/**",
    "packages/shared-schemas/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G0-CORE/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G0-CORE/**",
    "artifacts/conformance/T-G0-CORE/manifest.json"
  ],
  "writeSet": [
    "packages/domain/**",
    "packages/shared-schemas/**"
  ]
}
