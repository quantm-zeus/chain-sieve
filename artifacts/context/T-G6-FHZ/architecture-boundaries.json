{
  "ownerPackages": [
    "packages/failure-hazard"
  ],
  "allowedPaths": [
    "packages/failure-hazard/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
