  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G6-FHZ/**",
    "artifacts/conformance/T-G6-FHZ/manifest.json"
  ],
  "writeSet": [
    "packages/failure-hazard/**"
  ]
}
