{
  "ownerPackages": [
    "packages/solana-security"
  ],
  "allowedPaths": [
    "packages/solana-security/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G1-SOLSEC/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G1-SOLSEC/**",
    "artifacts/conformance/T-G1-SOLSEC/manifest.json"
  ],
  "writeSet": [
    "packages/solana-security/**"
  ]
}
