{
  "ownerPackages": [
    "apps/collector"
  ],
  "allowedPaths": [
    "apps/collector/**",
    "packages/collector-core/**",
    "packages/collector-solana/**",
    "packages/program-decoders/**",
    "tests/acceptance/**",
    "tests/negative/**",
