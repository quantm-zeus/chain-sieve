{
  "ownerPackages": [
    "packages/security"
  ],
  "allowedPaths": [
    "packages/security/**",
    "packages/tenant-isolation/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G0-SEC-02/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G0-SEC-02/**",
    "artifacts/conformance/T-G0-SEC-02/manifest.json"
  ],
  "writeSet": [
    "packages/security/**",
    "packages/tenant-isolation/**"
  ]
}
