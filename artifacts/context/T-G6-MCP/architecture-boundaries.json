{
  "ownerPackages": [
    "apps/api/src/mcp"
  ],
  "allowedPaths": [
    "apps/api/src/mcp/**",
    "packages/tool-core/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G6-MCP/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G6-MCP/**",
    "artifacts/conformance/T-G6-MCP/manifest.json"
  ],
  "writeSet": [
    "apps/api/src/mcp/**",
    "packages/tool-core/**"
  ]
}
