{
  "ownerPackages": [
    "packages/adversarial-simulator"
  ],
  "allowedPaths": [
    "packages/adversarial-simulator/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G7-AMS/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G7-AMS/**",
    "artifacts/conformance/T-G7-AMS/manifest.json"
  ],
  "writeSet": [
    "packages/adversarial-simulator/**"
  ]
}
