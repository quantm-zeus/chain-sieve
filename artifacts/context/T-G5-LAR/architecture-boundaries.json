{
  "ownerPackages": [
    "packages/liquidity-resilience"
  ],
  "allowedPaths": [
    "packages/liquidity-resilience/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G5-LAR/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G5-LAR/**",
    "artifacts/conformance/T-G5-LAR/manifest.json"
  ],
  "writeSet": [
    "packages/liquidity-resilience/**"
  ]
}
