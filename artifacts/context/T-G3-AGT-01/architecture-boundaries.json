{
  "ownerPackages": [
    "packages/agent-runtime"
  ],
  "allowedPaths": [
    "packages/agent-runtime/**",
    "packages/evidence/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
