{
  "ownerPackages": [
    "packages/persistence"
  ],
  "allowedPaths": [
    "packages/persistence/**",
    "packages/evidence/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**",
    "infra/migrations/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G0-DATA/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G0-DATA/**",
    "artifacts/conformance/T-G0-DATA/manifest.json"
  ],
  "writeSet": [
    "packages/persistence/**",
    "packages/evidence/**"
  ]
}
