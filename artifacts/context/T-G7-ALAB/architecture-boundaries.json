{
  "ownerPackages": [
    "packages/offline-alpha-lab"
  ],
  "allowedPaths": [
    "packages/offline-alpha-lab/**",
    "packages/alpha-artifact-store/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G7-ALAB/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G7-ALAB/**",
    "artifacts/conformance/T-G7-ALAB/manifest.json"
  ],
  "writeSet": [
    "packages/offline-alpha-lab/**",
    "packages/alpha-artifact-store/**"
  ]
}
