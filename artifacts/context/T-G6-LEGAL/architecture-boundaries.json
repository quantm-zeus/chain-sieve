{
  "ownerPackages": [
    "packages/public-claims-policy"
  ],
  "allowedPaths": [
    "packages/public-claims-policy/**",
    "packages/tenant-isolation/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G6-LEGAL/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G6-LEGAL/**",
    "artifacts/conformance/T-G6-LEGAL/manifest.json"
  ],
  "writeSet": [
    "packages/public-claims-policy/**",
    "packages/tenant-isolation/**"
  ]
}
