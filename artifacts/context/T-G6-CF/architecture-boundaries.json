{
  "ownerPackages": [
    "packages/counterfactual-lab"
  ],
  "allowedPaths": [
    "packages/counterfactual-lab/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G6-CF/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G6-CF/**",
    "artifacts/conformance/T-G6-CF/manifest.json"
  ],
  "writeSet": [
    "packages/counterfactual-lab/**"
  ]
}
