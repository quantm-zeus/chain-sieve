{
  "ownerPackages": [
    "packages/regime-router"
  ],
  "allowedPaths": [
    "packages/regime-router/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G5-REG/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G5-REG/**",
    "artifacts/conformance/T-G5-REG/manifest.json"
  ],
  "writeSet": [
    "packages/regime-router/**"
  ]
}
