{
  "ownerPackages": [
    "packages/research-notebook"
  ],
  "allowedPaths": [
    "packages/research-notebook/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G4-NB/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G4-NB/**",
    "artifacts/conformance/T-G4-NB/manifest.json"
  ],
  "writeSet": [
    "packages/research-notebook/**"
  ]
}
