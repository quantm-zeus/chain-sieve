{
  "ownerPackages": [
    "packages/provider-lifecycle"
  ],
  "allowedPaths": [
    "packages/provider-lifecycle/**",
    "packages/providers/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G0-PROV-02/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G0-PROV-02/**",
    "artifacts/conformance/T-G0-PROV-02/manifest.json"
  ],
  "writeSet": [
    "packages/provider-lifecycle/**",
    "packages/providers/**"
  ]
}
