{
  "ownerPackages": [
    "packages/shadow-portfolio"
  ],
  "allowedPaths": [
    "packages/shadow-portfolio/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G7-SPF/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G7-SPF/**",
    "artifacts/conformance/T-G7-SPF/manifest.json"
  ],
  "writeSet": [
    "packages/shadow-portfolio/**"
  ]
}
