{
  "ownerPackages": [
    "packages/social-capability"
  ],
  "allowedPaths": [
    "packages/social-capability/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G5-SOC/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G5-SOC/**",
    "artifacts/conformance/T-G5-SOC/manifest.json"
  ],
  "writeSet": [
    "packages/social-capability/**"
  ]
}
