{
  "ownerPackages": [
    "packages/discovery-universe"
  ],
  "allowedPaths": [
    "packages/discovery-universe/**",
    "packages/cheap-monitor/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G0-DISC/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G0-DISC/**",
    "artifacts/conformance/T-G0-DISC/manifest.json"
  ],
  "writeSet": [
    "packages/discovery-universe/**",
    "packages/cheap-monitor/**"
  ]
}
