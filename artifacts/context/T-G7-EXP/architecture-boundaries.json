{
  "ownerPackages": [
    "packages/exploration-bandit"
  ],
  "allowedPaths": [
    "packages/exploration-bandit/**",
    "tests/acceptance/**",
    "tests/negative/**",
    "tests/task-facets/**",
    "tests/fixtures/**",
    "docs/implementation/**"
  ],
  "forbiddenPaths": [
    "docs/spec/**",
    "artifacts/spec/**",
    "tasks/generated/**",
    ".github/workflows/**",
    "tests/conformance/**",
    "artifacts/conformance/T-G7-EXP/**",
    "infra/migrations/**"
  ],
  "readSet": [
    "docs/spec/**",
    "artifacts/context/T-G7-EXP/**",
    "artifacts/conformance/T-G7-EXP/manifest.json"
  ],
  "writeSet": [
    "packages/exploration-bandit/**"
  ]
}
