NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://ciag:ciag_dev_only@127.0.0.1:5432/ciag
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_ROOT=.local/object-store
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ciag-artifacts
S3_ACCESS_KEY_ID=ciag
S3_SECRET_ACCESS_KEY=ciag_dev_only
S3_FORCE_PATH_STYLE=true
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173
MCP_BOOTSTRAP_TOKEN=replace-with-a-local-secret
MCP_MAX_BODY_BYTES=65536
MCP_MAX_CONCURRENT=4
MCP_RATE_PER_MINUTE=60
LOG_LEVEL=info
CAPABILITY_MODE=SYNTHETIC_SHADOW
