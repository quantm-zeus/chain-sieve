{
  "schemaVersion": "1.0.0",
  "mode": "FULL_AUTONOMY",
  "humanReviewRequired": false,
  "humanApprovalRequired": false,
  "automatedIndependentReviewRequired": true,
  "deterministicVerificationRequired": true,
  "allowAutonomousSpecificationResolution": true,
